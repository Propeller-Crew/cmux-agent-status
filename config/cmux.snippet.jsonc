// Merge these keys into ~/.config/cmux/cmux.json, then run `cmux reload-config`.
{
  // Required: the launchd sync job runs outside cmux and needs socket access.
  "automation": { "socketControlMode": "automation" },

  // Glass sidebar: a thin tint, white in light mode, black in dark.
  // Also: defaults write com.cmuxterm.app sidebarBlendMode -string behindWindow
  //       defaults write com.cmuxterm.app sidebarMaterial -string sidebar
  "sidebarAppearance": { "tintOpacity": 0.3, "lightModeTintColor": "#FFFFFF", "darkModeTintColor": "#000000" },

  // Tab strip: bigger titles, a Claude button and a "Claude on a new branch" button
  // (claude -w: its own git worktree, so parallel Claudes don't overwrite each other).
  // icons/claude.png is cmux's own Claude icon, extracted by install.sh.
  "surfaceTabBar": { "fontSize": 12.5 },
  "actions": {
    "claude-new-tab": { "type": "agent", "agent": "claude", "title": "Claude", "target": "newTabInCurrentPane", "palette": true },
    // Finds the repo even when the workspace folder isn't one (from the paths its Claude sessions touched).
    "claude-worktree-tab": { "type": "command", "command": "~/.config/cmux/claude-worktree", "title": "Claude on a new branch", "palette": true }
  },
  "ui": {
    "surfaceTabBar": {
      "buttons": [
        { "action": "claude-new-tab", "title": "Claude", "icon": { "type": "image", "path": "./icons/claude.png" } },
        { "action": "claude-worktree-tab", "title": "Claude on a new branch", "icon": { "type": "symbol", "name": "arrow.triangle.branch" } },
        "cmux.newBrowser", "cmux.splitRight"
      ]
    }
  }
}
