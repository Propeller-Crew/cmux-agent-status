// Merge these keys into ~/.config/cmux/cmux.json, then run `cmux reload-config`.
{
  // Required: the launchd sync job runs outside cmux and needs socket access.
  "automation": { "socketControlMode": "automation" },

  // Glass sidebar: a thin tint over the glass so the text stays readable, white in light
  // mode, black in dark. The terminal can stay opaque (config/ghostty.config): the glass
  // is the sidebar material, not the window. install.sh --glass also runs:
  //   defaults write com.cmuxterm.app sidebarBlendMode -string behindWindow
  //   defaults write com.cmuxterm.app sidebarMaterial -string menu
  //   defaults write com.cmuxterm.app sidebarState -string active   (glass when unfocused too)
  "sidebarAppearance": { "tintOpacity": 0.15, "lightModeTintColor": "#FFFFFF", "darkModeTintColor": "#000000" },

  // Tab strip: bigger titles, a Claude button and a "Claude on a new branch" button
  // (claude -w: its own git worktree, so parallel Claudes don't overwrite each other).
  // icons/claude.png is cmux's own Claude icon, extracted by install.sh.
  "surfaceTabBar": { "fontSize": 12.5 },
  "actions": {
    "claude-new-tab": { "type": "agent", "agent": "claude", "title": "Claude", "target": "newTabInCurrentPane", "palette": true },
    // Finds the repo even when the workspace folder isn't one (from the paths its Claude sessions touched).
    "claude-worktree-tab": { "type": "command", "command": "~/.config/cmux/claude-worktree", "title": "Claude on a new branch", "palette": true },
    // Cmd+N / "+" open a workspace with Claude already running; a plain terminal is a right-click on "+".
    "claude-workspace": { "type": "workspaceCommand", "title": "Claude", "commandName": "Claude workspace", "palette": true }
  },
  "commands": [{
    "name": "Claude workspace",
    "description": "New workspace with Claude running",
    "workspace": { "name": "New session", "cwd": ".", "layout": { "pane": { "surfaces": [{ "type": "terminal", "command": "claude" }] } } }
  }],
  "ui": {
    "newWorkspace": {
      "action": "claude-workspace",
      "contextMenu": [
        { "action": "claude-workspace", "title": "Claude" },
        { "type": "separator" },
        { "action": "cmux.newTerminal", "title": "Terminal" },
        { "action": "cmux.newBrowser", "title": "Browser" }
      ]
    },
    "surfaceTabBar": {
      "buttons": [
        { "action": "claude-new-tab", "title": "Claude", "icon": { "type": "image", "path": "./icons/claude.png" } },
        { "action": "claude-worktree-tab", "title": "Claude on a new branch", "icon": { "type": "symbol", "name": "arrow.triangle.branch" } },
        "cmux.newBrowser", "cmux.splitRight"
      ]
    }
  }
}
