# System 1: the terminal as a 1984 Macintosh, 1-bit black ink on white paper, in pixel
# type. scripts/skin.sh copies this to ~/.config/ghostty/cmux-skin, which
# ~/.config/ghostty/config includes last, so these lines win.

# Departure Mono (fonts/, SIL OFL 1.1; scripts/skin.sh installs it) has the whole
# Ukrainian alphabet. It is drawn on an 11 px grid, so 11 pt is exactly two screen
# pixels per font pixel on Retina: crisp, no half pixels.
font-family = Departure Mono
font-size = 11

# Opaque paper: no glass.
background-opacity = 1
background-blur = false
background = #FFFFFF
foreground = #000000
cursor-color = #000000
cursor-text = #FFFFFF
selection-background = #000000
selection-foreground = #FFFFFF

# 1-bit, with greys so colours that differ still differ (System 1 drew dimmed things
# in dithered grey): red, blue and magenta print black; green, yellow and cyan grey.
palette = 0=#000000
palette = 1=#000000
palette = 2=#555555
palette = 3=#555555
palette = 4=#000000
palette = 5=#000000
palette = 6=#555555
palette = 7=#AAAAAA
palette = 8=#777777
palette = 9=#000000
palette = 10=#555555
palette = 11=#555555
palette = 12=#000000
palette = 13=#000000
palette = 14=#555555
palette = 15=#FFFFFF

# Programs written for a dark terminal print white text; Ghostty flips any text that
# would vanish against its background.
minimum-contrast = 3
