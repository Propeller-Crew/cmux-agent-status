# Glass sidebar, solid terminal. After edits: cmux reload-config
# The sidebar's glass comes from cmux itself (sidebarMaterial, sidebarBlendMode), so the
# terminal stays opaque: white in light mode, dark in dark, with no seam along its edge.
# For a translucent terminal too: background-opacity = 0.8 and background-blur = 30.
background-opacity = 1
# Room between the sidebar's edge and the text (applies to newly opened tabs).
window-padding-x = 14
